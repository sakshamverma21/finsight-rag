# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# LLM (via LiteLLM). Gemini free tier: get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Alternatives (swap the model in finsight/config.py):
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# SEC EDGAR requires a User-Agent contact email (any real email; not authentication).
# Use a dedicated address, not a personal one, if deploying publicly.
EDGAR_IDENTITY=your-email@example.com
